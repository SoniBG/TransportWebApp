@using Microsoft.AspNetCore.Components.Routing
@using Microsoft.AspNetCore.Components.Authorization
@inject NavigationManager Nav

<nav class="main-nav">
    <ul class="menu @(IsOpen ? "open" : null)">
        <li><NavLink href="/" Match="NavLinkMatch.All" class="nav-link">Home</NavLink></li>
        <li><NavLink href="/orders" Match="NavLinkMatch.Prefix" class="nav-link">Orders</NavLink></li>
        <li><NavLink href="/about" Match="NavLinkMatch.Prefix" class="nav-link">About</NavLink></li>

        <AuthorizeView>
            <Authorized>
                <li><NavLink href="/Account/Manage" Match="NavLinkMatch.Prefix" class="nav-link">Profile</NavLink></li>
            </Authorized>
        </AuthorizeView>

        <AuthorizeView Roles="Admin">
            <li><NavLink href="/Admin" Match="NavLinkMatch.Prefix" class="nav-link">Administration</NavLink></li>
        </AuthorizeView>

        <!-- Single item that flips between Log in / Log out -->
        <li class="auth">
            <AuthorizeView>
                <Authorized>
                    <form class="auth-form" method="post" action="/Account/Logout">
                        <AntiforgeryToken />
                        <input type="hidden" name="returnUrl" value="/" />
                        <button class="nav-link as-button" type="submit">Log out</button>
                    </form>
                </Authorized>
                <NotAuthorized>
                    <a class="nav-link" href="/Account/Login">Log in</a>
                </NotAuthorized>
            </AuthorizeView>
        </li>
    </ul>
</nav>

@code {
    [Parameter] 
    public bool IsOpen { get; set; }
}
